# ============================================================================
# TICKLY - HELP DESK & TICKET YÖNETİM SİSTEMİ
# Environment Configuration File
# ============================================================================
# Proje: Tickly v1.0.0
# Teknoloji: ASP.NET Core 8.0, React 18, TypeScript
# Veritabanı: PostgreSQL / SQLite
# ============================================================================

# ============================================================================
# VERİTABANI AYARLARI
# ============================================================================

# Database Provider (Sqlite veya PostgreSQL)
DATABASE_PROVIDER=Sqlite

# SQLite Configuration (Development)
SQLITE_CONNECTION_STRING=Data Source=tickly.db

# PostgreSQL Configuration (Production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=tickly
POSTGRES_USER=tickly_user
POSTGRES_PASSWORD=change_this_strong_password_123!

# Database Timeout & Retry Settings
DB_COMMAND_TIMEOUT=30
DB_RETRY_COUNT=5
DB_RETRY_DELAY_SECONDS=5

# ============================================================================
# GÜVENLİK AYARLARI
# ============================================================================

# JWT Token Configuration (Minimum 32 karakter)
# Üretmek için: openssl rand -base64 32
JWT_SECRET_KEY=please_generate_a_secure_random_key_minimum_32_chars_here_use_openssl_rand_base64_32
JWT_ISSUER=tickly.local
JWT_AUDIENCE=tickly.local
JWT_EXPIRE_HOURS=24

# BCrypt Work Factor (10-12 önerilir, yükseldikçe yavaşlar ama güvenli olur)
BCRYPT_WORK_FACTOR=12

# Admin Kullanıcı (İlk kurulumda otomatik oluşturulur)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tickly.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_FULL_NAME=Sistem Yöneticisi

# ============================================================================
# EMAIL ENTEGRASYONU
# ============================================================================

# SMTP - Giden Email Ayarları
EMAIL_SMTP_ENABLED=true
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=ticklydestek@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password-here
EMAIL_SMTP_FROM_EMAIL=ticklydestek@gmail.com
EMAIL_SMTP_FROM_NAME=Tickly Destek Sistemi
EMAIL_SMTP_USE_SSL=true

# IMAP - Gelen Email Ayarları (Otomatik Ticket Oluşturma)
EMAIL_IMAP_ENABLED=true
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=support@company.com
EMAIL_IMAP_PASSWORD=your-app-password-here
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_CHECK_INTERVAL_MINUTES=1

# Email İçin Default Departman ID (IMAP'ten gelen ticketlar için)
EMAIL_DEFAULT_DEPARTMENT_ID=1

# ============================================================================
# UYGULAMA AYARLARI
# ============================================================================

# Frontend URL
APP_BASE_URL=http://localhost:5173
APP_ENVIRONMENT=Development

# CORS - İzin Verilen Originler (Production için virgülle ayırın)
ALLOWED_ORIGINS=http://localhost:5173,https://tickly.local,https://www.tickly.local

# ============================================================================
# DOSYA YÖNETİMİ
# ============================================================================

# Attachment Storage Path
STORAGE_ATTACHMENTS_PATH=./uploads

# İzin Verilen Dosya Türleri (virgülle ayırın)
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.docx,.xlsx,.txt,.zip

# Maksimum Dosya Boyutu (MB)
MAX_FILE_SIZE_MB=10

# ============================================================================
# SLA (SERVICE LEVEL AGREEMENT) AYARLARI
# ============================================================================

# SLA Monitoring Interval (dakika)
SLA_CHECK_INTERVAL_MINUTES=1

# SLA Uyarı Süresi (bitiş süresinden ne kadar önce uyarı verilsin - dakika)
SLA_WARNING_BEFORE_MINUTES=60

# ============================================================================
# OTOMASYON AYARLARI
# ============================================================================

# Otomasyon Kuralları Aktif mi?
AUTOMATION_ENABLED=true

# Otomasyon Kontrol Aralığı (saniye)
AUTOMATION_CHECK_INTERVAL_SECONDS=30

# ============================================================================
# SIGNALR REAL-TIME AYARLARI
# ============================================================================

# SignalR Hub Timeout (saniye)
SIGNALR_CLIENT_TIMEOUT_SECONDS=30
SIGNALR_KEEP_ALIVE_INTERVAL_SECONDS=15

# ============================================================================
# LOGLAMA AYARLARI
# ============================================================================

# Log Level: Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_MICROSOFT_HOSTING=Information

# Audit Log Retention (gün - 0 ise süresiz)
AUDIT_LOG_RETENTION_DAYS=90

# ============================================================================
# PERFORMANS VE ÖLÇEKLENEBİLİRLİK
# ============================================================================

# Cache Timeout (dakika)
CACHE_TIMEOUT_MINUTES=60

# Rate Limiting (dakika başına maksimum istek)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# GELİŞTİRME AYARLARI
# ============================================================================

# Swagger/OpenAPI Dokümantasyonu (Production'da false olmalı)
ENABLE_SWAGGER=true

# Detaylı Hata Mesajları (Production'da false olmalı)
ENABLE_DETAILED_ERRORS=true

# Seed Data (İlk kurulumda örnek veri oluştur)
ENABLE_SEED_DATA=false

# ============================================================================
# GELECEK PLANLAR (Henüz implement edilmedi)
# ============================================================================

# Redis Cache (Horizontal Scaling için)
# REDIS_ENABLED=false
# REDIS_CONNECTION_STRING=localhost:6379

# Azure Storage (Dosyalar için)
# AZURE_STORAGE_ENABLED=false
# AZURE_STORAGE_CONNECTION_STRING=

# Two-Factor Authentication
# TWO_FACTOR_ENABLED=false

# SSO/SAML Integration
# SSO_ENABLED=false
# SAML_ISSUER=

# Chatbot Integration
# CHATBOT_ENABLED=false
# CHATBOT_API_KEY=

# ============================================================================
# NOTLAR
# ============================================================================
# 1. Production ortamında mutlaka güçlü şifreler kullanın
# 2. JWT_SECRET_KEY'i güvenli bir şekilde saklayın
# 3. Email şifreleri için App Password kullanın (Gmail)
# 4. CORS ayarlarını production domain'lerinize göre düzenleyin
# 5. SQLite sadece development için, production'da PostgreSQL kullanın
# 6. Bu dosyayı .gitignore'a ekleyin, asla Git'e push etmeyin
# ============================================================================
